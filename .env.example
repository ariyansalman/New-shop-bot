# ==========================================================================
# Telegram Bot
# ==========================================================================
BOT_TOKEN=123456:ABC-your-token-from-BotFather
# The "primary" admin - required. Order/payment notifications go here, and
# this ID is always treated as an admin even if ADMIN_TELEGRAM_IDS is empty.
ADMIN_TELEGRAM_ID=123456789
# Optional: extra admins, comma-separated. Leave empty for a single admin.
ADMIN_TELEGRAM_IDS=
ADMIN_TELEGRAM_USERNAME=your_username
# Your bot's username WITHOUT the @ (used for the CryptoBot "back to bot" button)
BOT_USERNAME=your_bot_username

# ==========================================================================
# Database — Supabase (PostgreSQL)
# ==========================================================================
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# Use the "Session pooler" string (port 5432). It is IPv4-friendly, which is
# what Railway needs; the direct connection is IPv6-only.
#
# If your password contains @ : / ? # or & you MUST URL-encode it
# (e.g. p@ss -> p%40ss), otherwise the URL cannot be parsed.
DATABASE_URL=postgresql://postgres.abcdefghijklm:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Connection pool (keep small: Supabase caps concurrent connections)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=900
DB_ECHO=false

# ==========================================================================
# Payments
# ==========================================================================
# @CryptoBot -> Crypto Pay -> My Apps -> API token
CRYPTO_BOT_API_KEY=

# @BotFather -> your bot -> Payments -> connect a provider
TELEGRAM_PROVIDER_TOKEN=
# Must be a USD-denominated provider so amounts match wallet balances
PAYMENT_CURRENCY=USD

# Wallet top-up limits (USD)
MIN_TOPUP_AMOUNT=1
MAX_TOPUP_AMOUNT=100000

# Invoice lifetime (hours) and polling interval (seconds)
PAYMENT_EXPIRY_HOURS=0.5
PAYMENT_CHECK_INTERVAL=30

# ==========================================================================
# HTTP server (CryptoBot webhook + Railway healthcheck)
# ==========================================================================
# Railway injects PORT automatically — do NOT set it there.
PORT=8080
WEBHOOK_ENABLED=true

# ==========================================================================
# Error monitoring (optional)
# ==========================================================================
# Leave empty to disable. Every logger.error()/logger.exception() call the
# app already makes gets reported automatically once this is set - see
# config/monitoring.py. Get a DSN from https://sentry.io (free tier available).
SENTRY_DSN=

# ==========================================================================
# Storage
# ==========================================================================
# Railway's filesystem is ephemeral. Attach a Volume mounted at /data and set
# ASSETS_DIR=/data/assets, or uploaded logos/images vanish on every redeploy.
ASSETS_DIR=assets

LOG_LEVEL=INFO
